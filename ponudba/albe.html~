		<script>
		var x = 1;

			function NaprejSlika()
  			{
				x++;
				if (x>5) {x--;}
				var y = 'slike/albe/'+x+'.JPG';	
 		 		document.getElementById("mojaSlika").src=y;
				document.getElementById("stevec").innerHTML=x+"/5";
			}
		
			function NazajSlika()
		  	{
				x--;
				if (x<1) {x++;}
				var y = 'slike/albe/'+x+'.JPG';	
 		 		document.getElementById("mojaSlika").src=y;
				document.getElementById("stevec").innerHTML=x+"/5";
			}		
		</script>
		
