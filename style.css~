/* DRSNICE SLIK */
.drsnice{
    width: 100%;
    background-color: rgb(90, 171, 230);
}
.slike{
    width: 45vw;
    height: 28vw;
    margin: 0 auto;
    padding: 20px;
}
.slike img{
    width: 45vw;
    position: absolute;
    transition: all 0.5s;
    background-color: rgb(90, 171, 230);
}
