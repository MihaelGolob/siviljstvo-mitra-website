/* KONEC - KONTAKT */
footer{
	width:100%;
	height:100px;
	bottom:0;
	left:0;
    z-index: 1;
    text-align: center;
    background-color: rgb(40, 105, 154);
    cursor: default;
    /* Da nemoreš označiti besedila */
