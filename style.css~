/* CELOTNA SPLETNA STRAN */
html, body{
    margin: 0;
    padding: 0;
    scrollbar-base-color: #1973a2; 
    scrollbar-arrow-color: #00a7ff;
}
h2{
    font-family: 'Poiret One', cursive;
    font-size: 30px;
    text-align: left;
}
h1{
    margin: 0;
    padding: 20px;
    font-family: 'Poiret One', cursive;
    text-align: center;
}
/*---------------------------------------------------------*/
/*---------------------------------------------------------*/

/* MENU */
.menu{
    z-index: 2;
    position: fixed; 
    margin: 0;
    background-color: #226393;
    width: 250px;
    height: 100%;
    box-shadow: 2px 0px 5px #333;
    overflow: auto;
    overflow-x: hidden;
    /* Da nemoreš označiti besedila */
    -webkit-user-select: none;  
    -moz-user-select: none;    
    -ms-user-select: none;      
    user-select: none;
}
.menu .gradient{
    background: radial-gradient(circle, #d2fdb6, #226393 80%);
}
.menu img{
    width: 200px;
    padding: 5px 25px;
}
.menu img:first-child{margin-bottom: -30px;}
.menu img:last-child{margin-bottom: 70px;}

.ime{
    float: left;
    clear: both;
    padding: 5px;
    margin-bottom: 40px;
    font-family: 'Great Vibes', cursive;
    font-size: 40px;
    color: white;
    cursor: pointer;
    text-decoration: none;
}
.zavihekTrenutni{
    margin: 10px;
    padding: 10px;
    font-family: 'Great Vibes', cursive;
    font-size: 38px ;
    color: #023646;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.5s;
    float: left;
    clear: both;
}
.zavihekTrenutni:hover{
    color: #023646;
}
.zavihek{
    margin: 10px;
    padding: 10px;
    font-family: 'Great Vibes', cursive;
    font-size: 38px;
    color: white;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.5s;
    float: left;
    clear: both;
}
.zavihek:hover{
    color: #023646;
}
