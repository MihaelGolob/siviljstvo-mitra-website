    margin: 0px;
    padding: 5px;
    font-family: 'Poiret One', cursive;
    font-weight: bold;
}
.logo{
    opacity: 0.5;
    float: left;
    padding: 5px;
    transition: all 0.3s;
}
.logo:hover{
    opacity: 1;
}
.logo:first-child{
    margin-left: 250px;
}
.logo img{
    height: 50px;
}
.jezik{
    opacity: 0.5;
    padding: 5px;
    float: right;
    transition: all 0.3s;
}
.jezik:hover{
